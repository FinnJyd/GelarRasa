# Template Environment Variables (Safe to commit to GitHub)
# Copy this file to .env and set your actual values

# Legacy notebook helper (unused by the dashboard app)
GDRIVE_FILE_ID=paste_drive_file_id_here

# OpenAI-compatible chat API for the dashboard assistant (server-side only; never expose to the browser).
# Works with any OpenAI-compatible provider: set OPENAI_BASE_URL to the provider's /v1 endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini