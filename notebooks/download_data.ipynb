   "source": [
    "# 2. Imports & Project Root Setup\n",
    "import os\n",
    "import re\n",
    "import zipfile\n",
    "import gdown\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "# Resolve project root (whether notebook is run from root or from notebooks/)\n",
    "cwd = os.getcwd()\n",
    "if os.path.basename(cwd) == \"notebooks\":\n",
    "    PROJECT_ROOT = os.path.abspath(os.path.join(cwd, \"..\"))\n",
    "else:\n",
    "    PROJECT_ROOT = cwd\n",
    "\n",
    "print(f\"Project Root: {PROJECT_ROOT}\")\n",
    "\n",
    "# Load .env from project root\n",
    "env_path = os.path.join(PROJECT_ROOT, \".env\")\n",
    "load_dotenv(dotenv_path=env_path)\n",
    "\n",
    "raw_input_val = os.getenv(\"GDRIVE_FILE_ID\", \"\").strip()\n",
    "\n",
    "# Fallback prompt if .env is empty or still has placeholder\n",
    "if not raw_input_val or raw_input_val == \"paste_drive_file_id_here\":\n",
    "    raw_input_val = input(\"Enter Google Drive File ID or Shareable Link: \").strip()\n",
    "\n",
    "# Extract File ID if a full Google Drive URL was pasted\n",
    "match = re.search(r\"/d/([a-zA-Z0-9_-]+)\", raw_input_val) or re.search(r\"id=([a-zA-Z0-9_-]+)\", raw_input_val)\n",
    "FILE_ID = match.group(1) if match else raw_input_val\n",
    "\n",
    "print(f\"Using Google Drive File ID: {FILE_ID[:5]}...{FILE_ID[-5:] if len(FILE_ID) > 10 else ''}\")"
   ]
  },
